{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "version": {
            "type": "string"
        },
        "tier": {
            "type": "string",
            "enum": [
                "starter",
                "pro",
                "enterprise"
            ]
        },
        "agents": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "limits": {
            "type": "object"
        },
        "license": {
            "type": "string"
        }
    },
    "required": [
        "name",
        "version",
        "tier",
        "agents"
    ]
}