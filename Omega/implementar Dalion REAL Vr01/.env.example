# Dalion + Arqos Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Database Configuration
# ============================================
DB_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://dalion_user:your_secure_password_here@localhost:5432/dalion

# ============================================
# Threat Intelligence API Keys
# ============================================

# VirusTotal API
# Get free key at: https://www.virustotal.com/gui/join-us
# Free tier: 4 requests/minute, 500 requests/day
VT_API_KEY=your_virustotal_api_key_here

# AbuseIPDB API
# Get free key at: https://www.abuseipdb.com/api
# Free tier: 1,000 requests/day
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# Shodan API (optional)
# Get key at: https://account.shodan.io/
SHODAN_API_KEY=

# AlienVault OTX (optional)
# Get key at: https://otx.alienvault.com/
OTX_API_KEY=

# ============================================
# Firewall/WAF Integration
# ============================================

# Cloudflare (for edge blocking)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=

# AWS WAF (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ============================================
# Application Configuration
# ============================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Redis Configuration
REDIS_URL=redis://localhost:6379

# ============================================
# Monitoring (optional)
# ============================================

# Grafana
GRAFANA_PASSWORD=admin

# Sentry (error tracking)
SENTRY_DSN=

# ============================================
# Security Configuration
# ============================================

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ============================================
# Feature Flags
# ============================================

# Enable/disable specific agents
ENABLE_D2_SENTINELA=true
ENABLE_D3_ESPIONAGEM=true
ENABLE_D12_ROTTWEILER=true

# Enable ML-based detection (requires models)
ENABLE_ML_DETECTION=false

# Enable real-time blocking (USE WITH CAUTION!)
ENABLE_AUTO_BLOCKING=false

# ============================================
# Development/Testing
# ============================================

# Use mock APIs instead of real ones (for testing)
USE_MOCK_APIS=false

# Reduce rate limits for development
DEV_MODE=false
